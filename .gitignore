# Dependencies. Deliberately NOT anchored to the root: nested node_modules
# directories are just as unwanted as the top-level one.
node_modules/

# --- Root-level build artefacts -------------------------------------------
#
# Every pattern below is anchored with a leading `/`, and that is load-bearing
# rather than tidiness. An unanchored `build/` matches a directory named `build`
# at *any* depth, so it silently ignored `src/build/` - the entire build
# subsystem - and the repository was published without it. Anchoring keeps each
# of these to the artefact it was written for.

# tsup output. NOT the generated site: the CLI's default `--out` is ./dist
# relative to the *user's* cwd, so the two never collide.
/build/

# Generated sites from tests and manual runs.
/dist/
/.tmp/

# Vendored, generated by `npm run vendor` from the pinned htmx.org devDependency.
/vendor/

# Test artefacts.
/coverage/
/playwright-report/
/test-results/
*.log

# Real-world EPUBs dropped in for local smoke testing. Large, and not ours to
# redistribute.
test/fixtures/real/