# Dependencies
node_modules/

# Package build output (tsup). NOT the generated site: the CLI's default
# `--out` is ./dist relative to the user's cwd, so the two never collide.
build/

# Generated sites from tests and manual runs
dist/
.tmp/

# Vendored, generated by `npm run vendor` from the pinned htmx.org devDependency
vendor/

# Real-world EPUBs dropped in for local smoke testing (spec P7)
test/fixtures/real/

# Test artefacts
coverage/
playwright-report/
test-results/
*.log
